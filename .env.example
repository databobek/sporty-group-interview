# Copy to .env and fill in. .env is gitignored.

# Your user-id for the application under test (required). Used in the UI URL
# /?user-id=<CANDIDATE_ID> and as the x-user-id header on every API call.
CANDIDATE_ID=

# Application base URL, without a trailing slash.
BASE_URL=https://qae-assignment-tau.vercel.app

# Run Chrome without a window: true/false (CI sets true).
HEADLESS=false

# Explicit-wait timeout for UI elements, in seconds.
UI_TIMEOUT=10

# HTTP request timeout for API calls, in seconds.
API_TIMEOUT=10
